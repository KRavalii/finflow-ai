APP_ENV=development
FINFLOW_DEMO_MODE=false
FINFLOW_SERVE_FRONTEND=false
CORS_ORIGINS=
DB_HOST=replace_with_database_host
DB_PORT=5432
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
# Production requires verify-full. Use a provider CA path if system roots do not work.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=system
