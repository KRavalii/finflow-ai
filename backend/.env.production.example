APP_ENV=production
PYTHON_VERSION=3.13.5
FINFLOW_DEMO_MODE=true
FINFLOW_SERVE_FRONTEND=false
# Exact production origin; no trailing slash. Leave empty only for same-origin hosting.
CORS_ORIGINS=https://replace-with-frontend.vercel.app
# Copy the session-pooler host from Supabase Connect; do not infer it from the region.
FINFLOW_SUPABASE_PROJECT_REF=replace_with_20_character_project_ref
DB_HOST=replace_with_session_pooler_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=finflow_reader.replace_with_project_ref
DB_PASSWORD=replace_with_database_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/secrets/supabase-ca.crt
# Render: upload the verified provider CA as Secret File supabase-ca.crt.
# For existing finflow_demo hosting, omit FINFLOW_SUPABASE_PROJECT_REF and use DB_NAME=finflow_demo.
