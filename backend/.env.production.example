APP_ENV=production
FINFLOW_DEMO_MODE=true
FINFLOW_SERVE_FRONTEND=false
# Leave empty for same-origin hosting; otherwise use your exact HTTPS frontend origin.
CORS_ORIGINS=
DB_HOST=replace_with_database_host
DB_PORT=5432
DB_NAME=finflow_demo
DB_USER=replace_with_read_only_database_user
DB_PASSWORD=replace_with_database_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=system
